# Copy to your shell environment; never commit real values.
HUGO_DEVICE_TOKEN=
HUGO_MEMORY_AUTO_PUSH=true
HUGO_MEMORY_SYNC_INTERVAL_MS=900000
# Optional private PC control bridge, never expose it publicly.
HUGO_PC_CONTROL_ENDPOINT=
# Local no-API-key AI. llama.cpp server exposes /v1/chat/completions.
HUGO_LOCAL_AI_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
HUGO_LOCAL_AI_MODEL=local-model
# Optional local voice HTTP adapters for Whisper.cpp and Piper.
HUGO_STT_ENDPOINT=
HUGO_STT_TOKEN=
HUGO_TTS_ENDPOINT=
HUGO_TTS_TOKEN=
# Optional local or private services. Leave blank when not installed.
OPEN_WEBUI_ENDPOINT=http://127.0.0.1:3000
HOME_ASSISTANT_ENDPOINT=
N8N_ENDPOINT=http://127.0.0.1:5678