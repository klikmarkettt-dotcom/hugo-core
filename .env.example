# Copy to your shell environment; never commit real values.
HUGO_DEVICE_TOKEN=
HUGO_MEMORY_AUTO_PUSH=true
HUGO_MEMORY_SYNC_INTERVAL_MS=900000
# Optional local model endpoint. No cloud provider is required.
HUGO_LOCAL_AI_ENDPOINT=
HUGO_LOCAL_AI_MODEL=local-model
# Optional local speech adapters.
HUGO_STT_ENDPOINT=
HUGO_STT_TOKEN=
HUGO_TTS_ENDPOINT=
HUGO_TTS_TOKEN=
# Optional local browser backend for screenshots and clicks.
HUGO_BROWSER_ENDPOINT=
# Optional approved Facebook/Meta publishing endpoint and token.
FACEBOOK_PUBLISH_ENDPOINT=
FACEBOOK_ACCESS_TOKEN=