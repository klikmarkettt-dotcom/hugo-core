{
  "version": "1.1.0",
  "policy": "external-adapter",
  "adapters": [
    { "id": "browser-use", "category": "vision", "source": "https://github.com/browser-use/browser-use", "transport": "http", "env": "BROWSER_USE_ENDPOINT", "capabilities": ["browse", "click", "type", "extract"] },
    { "id": "glazyr-viz", "category": "vision", "source": "https://github.com/senti-001/glazyr-viz", "transport": "http", "endpoint": "http://127.0.0.1:4545", "capabilities": ["dom-state", "screenshot", "mcp"] },
    { "id": "cognee", "category": "memory", "source": "https://github.com/topoteretes/cognee", "transport": "http", "env": "COGNEE_ENDPOINT", "capabilities": ["knowledge-graph", "semantic-search", "entity-extraction"] },
    { "id": "memex", "category": "memory", "source": "https://github.com/vndee/memex", "transport": "http", "env": "MEMEX_ENDPOINT", "capabilities": ["temporal-memory", "hybrid-search", "mcp"] },
    { "id": "gbrain", "category": "memory", "source": "https://github.com/garrytan/gbrain", "transport": "local", "capabilities": ["markdown-memory", "backlinks", "graph-reasoning"] },
    { "id": "open-jarvis", "category": "cognition", "source": "https://github.com/open-jarvis/OpenJarvis", "transport": "openai-compatible", "env": "OPEN_JARVIS_ENDPOINT", "capabilities": ["local-inference", "skills", "learning"] },
    { "id": "openclawminicrm", "category": "business", "source": "https://github.com/smlsoft/openclawminicrm", "transport": "http", "env": "CRM_ENDPOINT", "capabilities": ["crm", "sales", "support"] },
    { "id": "open-ai-social-agent", "category": "business", "source": "https://github.com/SamurAIGPT/open-ai-social-agent", "transport": "http", "env": "SOCIAL_AGENT_ENDPOINT", "capabilities": ["publishing", "listening", "trends"] },
    { "id": "open-ai-marketing-agent", "category": "business", "source": "https://github.com/SamurAIGPT/ai-marketing-agent", "transport": "http", "env": "MARKETING_AGENT_ENDPOINT", "capabilities": ["campaigns", "analytics", "multi-channel"] },
    { "id": "playwright", "category": "vision", "source": "https://github.com/microsoft/playwright", "transport": "local-package", "package": "playwright", "capabilities": ["chromium", "firefox", "webkit", "screenshots", "click", "type"] },
    { "id": "mcp-typescript-sdk", "category": "cognition", "source": "https://github.com/modelcontextprotocol/typescript-sdk", "transport": "local-package", "package": "@modelcontextprotocol/sdk", "capabilities": ["tools", "resources", "prompts"] },
    { "id": "mcp-servers", "category": "tools", "source": "https://github.com/modelcontextprotocol/servers", "transport": "external-process", "capabilities": ["filesystem", "git", "fetch", "memory", "time"] },
    { "id": "langgraph", "category": "cognition", "source": "https://github.com/langchain-ai/langgraph", "transport": "external-service", "capabilities": ["checkpointing", "interrupts", "retries", "human-in-the-loop"] },
    { "id": "opentelemetry-js", "category": "system", "source": "https://github.com/open-telemetry/opentelemetry-js", "transport": "local-package", "package": "@opentelemetry/api", "capabilities": ["traces", "metrics", "logs"] },
    { "id": "llama-cpp", "category": "cognition", "source": "https://github.com/ggerganov/llama.cpp", "transport": "http", "env": "HUGO_LOCAL_AI_ENDPOINT", "endpoint": "http://127.0.0.1:8080", "healthPath": "/health", "capabilities": ["local-models", "chat", "embeddings", "openai-compatible"] },
    { "id": "open-webui", "category": "cognition", "source": "https://github.com/open-webui/open-webui", "transport": "http", "env": "OPEN_WEBUI_ENDPOINT", "endpoint": "http://127.0.0.1:3000", "healthPath": "/health", "capabilities": ["chat-ui", "model-routing", "document-chat"] },
    { "id": "home-assistant", "category": "devices", "source": "https://github.com/home-assistant/core", "transport": "http", "env": "HOME_ASSISTANT_ENDPOINT", "healthPath": "/api/", "capabilities": ["smart-home", "presence", "device-control"] },
    { "id": "n8n", "category": "automation", "source": "https://github.com/n8n-io/n8n", "transport": "http", "env": "N8N_ENDPOINT", "endpoint": "http://127.0.0.1:5678", "healthPath": "/healthz", "capabilities": ["workflows", "webhooks", "schedules"] },
    { "id": "whisper-cpp", "category": "voice", "source": "https://github.com/ggerganov/whisper.cpp", "transport": "local", "capabilities": ["speech-to-text", "offline-transcription"] },
    { "id": "piper", "category": "voice", "source": "https://github.com/rhasspy/piper", "transport": "local", "capabilities": ["text-to-speech", "offline-voice"] }
  ]
}