{
  "name": "Hugo Core",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Hugo private gateway",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm run first-run",
  "postStartCommand": "if [ -n \"${HUGO_DEVICE_TOKEN}\" ]; then npm run device:gateway; else echo 'HUGO_DEVICE_TOKEN is not configured; gateway is disabled.'; fi",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
